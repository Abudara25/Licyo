# Domaine principal du SaaS
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clé HMAC du Mode Miroir et du state OAuth (64 caractères aléatoires minimum)
IMPERSONATION_SECRET_KEY=une_cle_secrete_hmac_ultra_longue_pour_le_mode_miroir
# Clé AES-256 des identifiants e-mail des clubs : 32 octets en base64 (openssl rand -base64 32)
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (SaaS Billing + Connect pour les clubs)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_SAAS=whsec_...
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_...
STRIPE_PRICE_ID_VITRINE=price_...
STRIPE_PRICE_ID_INTEGRAL=price_...

# Serveur e-mail du SaaS (repli)
SMTP_HOST=smtp.ton-saas.com
SMTP_PORT=465
SMTP_USER=notifications@ton-saas.com
SMTP_PASSWORD=
EMAIL_FROM="Licyo <notifications@ton-saas.com>"

# Google OAuth (bouton « Connecter Gmail » des clubs)
# URI de redirection à déclarer : ${NEXT_PUBLIC_APP_URL}/api/email/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domaines personnalisés des clubs : cible du CNAME à créer chez leur registraire.
# Le proxy Caddy (deploy/Caddyfile) délivre le HTTPS à la demande après /api/domains/check.
CUSTOM_DOMAIN_CNAME_TARGET=sites.licyo.fr
