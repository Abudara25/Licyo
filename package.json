{
  "name": "licyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply licyo --local",
    "db:migrate:remote": "wrangler d1 migrations apply licyo --remote",
    "db:seed:local": "node --experimental-strip-types --no-warnings scripts/seed-d1.ts --local",
    "login-link": "node --experimental-strip-types --no-warnings scripts/login-link.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/**/*.test.ts\"",
    "db:seed:remote": "node --experimental-strip-types --no-warnings scripts/seed-d1.ts --remote"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@opennextjs/cloudflare": "^1.20.16",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/stripe-js": "^10.1.0",
    "@vercel/og": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "type": "module"
}
